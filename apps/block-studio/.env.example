# The newsroom API the studio reads live blocks from.
#
# The studio proxies these through its own origin (see next.config.mjs), so
# the browser never talks to the API directly and no CORS setup is needed.
#
# API_INTERNAL_URL   where the studio's server reaches the API
# NEXT_PUBLIC_API_URL  the API's public address, used as the fallback
API_INTERNAL_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000
