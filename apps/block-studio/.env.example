# The newsroom API the studio reads live blocks from.
#
# The studio proxies these through its own origin (see next.config.mjs), so
# the browser never talks to the API directly and no CORS setup is needed.
#
# API_INTERNAL_URL   where the studio's server reaches the API
# NEXT_PUBLIC_API_URL  the API's public address, used as the fallback
API_INTERNAL_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# Where the newsroom portal lives.
#
# The studio and the portal are the same product and share one session, so
# a sign-in in either is a sign-in in both. The address is configuration
# because the portal may be running on another machine or behind a tunnel.
NEXT_PUBLIC_WEB_URL=http://localhost:3002

# Where the newsroom CMS lives. Same idea, for the CMS's own address.
NEXT_PUBLIC_CMS_URL=http://localhost:3002
