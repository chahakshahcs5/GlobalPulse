{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "baseUrl": ".",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@ai-news/schemas": ["../../libs/schemas/src/index.ts"],
      "@ai-news/shared": ["../../libs/shared/src/index.ts"],
      "@ai-news/media": ["../../libs/media/src/index.ts"],
      "@ai-news/api-client": ["../../libs/api-client/src/index.ts"],
      "@ai-news/api-client/*": ["../../libs/api-client/src/*.ts"],
      "@ai-news/blocks-ui": ["../../libs/blocks-ui/src/index.ts"],
      "@ai-news/block-studio": ["../../libs/block-studio/src/index.ts"],
      "zod": ["../../libs/schemas/node_modules/zod"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
