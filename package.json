{
  "name": "ai-news-platform",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "build": "nx run-many --target=build",
    "test": "vitest run tests/unit tests/integration",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:e2e:browser": "playwright test",
    "test:all": "vitest run && playwright test",
    "test:watch": "vitest",
    "lint": "nx run-many --target=lint",
    "dev:api": "pnpm --filter @ai-news/api dev",
    "dev:mcp": "pnpm --filter @ai-news/mcp-server dev",
    "dev:web": "pnpm --filter @ai-news/web dev",
    "dev:worker": "pnpm --filter @ai-news/worker dev",
    "dev:mobile": "pnpm --filter @ai-news/mobile start",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:build": "docker compose build",
    "docker:status": "docker compose ps",
    "demo:e2e": "tsx scripts/demo-e2e.ts"
  },

  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.13.9",
    "nx": "^20.4.6",
    "prettier": "^3.5.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "nx"
    ]
  }
}
