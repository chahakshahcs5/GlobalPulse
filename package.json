{
  "name": "ai-news-platform",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "build": "nx run-many --target=build",
    "test": "vitest run tests/unit tests/integration",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:e2e:browser": "playwright test",
    "test:all": "vitest run && playwright test",
    "test:watch": "vitest",
    "lint": "nx run-many --target=lint",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "dev:mcp": "tsx watch apps/mcp-server/src/main.ts",
    "dev:web": "pnpm --filter @ai-news/web dev",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:build": "docker compose build",
    "docker:status": "docker compose ps",
    "demo:e2e": "tsx scripts/demo-e2e.ts"
  },

  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "@playwright/test": "^1.63.0",
    "@types/d3": "^7.4.3",
    "@types/node": "^22.13.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.6.1",
    "nx": "^20.4.6",
    "postcss": "^8.5.28",
    "prettier": "^3.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7",
    "zod": "^3.24.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "nx"
    ]
  }
}
