{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "useUnknownInCatchVariables": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": ".",
    "typeRoots": [
      "./node_modules/@types",
      "./apps/web/node_modules/@types",
      "./apps/api/node_modules/@types"
    ],
    "paths": {
      "@ai-news/schemas": ["libs/schemas/src/index.ts"],
      "@ai-news/shared": ["libs/shared/src/index.ts"],
      "@ai-news/database": ["libs/database/src/index.ts"],
      "@ai-news/content": ["libs/content/src/index.ts"],
      "@ai-news/stories": ["libs/stories/src/index.ts"],
      "@ai-news/events": ["libs/events/src/index.ts"],
      "@ai-news/topics": ["libs/topics/src/index.ts"],
      "@ai-news/entities": ["libs/entities/src/index.ts"],
      "@ai-news/sources": ["libs/sources/src/index.ts"],
      "@ai-news/search": ["libs/search/src/index.ts"],
      "@ai-news/auth": ["libs/auth/src/index.ts"],
      "@ai-news/media": ["libs/media/src/index.ts"],
      "@ai-news/observability": ["libs/observability/src/index.ts"],
      "@ai-news/jobs": ["libs/jobs/src/index.ts"],
      "@ai-news/graphql": ["libs/graphql/src/index.ts"],
      "react": ["apps/web/node_modules/@types/react"],
      "react/jsx-runtime": ["apps/web/node_modules/@types/react/jsx-runtime"],
      "react/*": ["apps/web/node_modules/@types/react/*"],
      "react-dom": ["apps/web/node_modules/@types/react-dom"],
      "react-dom/server": ["apps/web/node_modules/@types/react-dom/server"],
      "react-dom/*": ["apps/web/node_modules/@types/react-dom/*"],
      "lucide-react": ["apps/web/node_modules/lucide-react"],
      "@modelcontextprotocol/sdk": [
        "apps/mcp-server/node_modules/@modelcontextprotocol/sdk/dist/esm/index"
      ],
      "@modelcontextprotocol/sdk/*": [
        "apps/mcp-server/node_modules/@modelcontextprotocol/sdk/dist/esm/*"
      ],
      "fastify": ["apps/api/node_modules/fastify"],
      "fastify/*": ["apps/api/node_modules/fastify/*"],
      "rxjs": ["apps/api/node_modules/rxjs"],
      "rxjs/*": ["apps/api/node_modules/rxjs/*"],
      "zod": ["libs/schemas/node_modules/zod"],
      "react-native": ["apps/mobile/src/react-native-compat.tsx"]
    }
  },
  "exclude": ["node_modules", "dist", "coverage"]
}
