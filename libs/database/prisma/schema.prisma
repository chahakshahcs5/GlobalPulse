datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "fullTextSearchPostgres"]
}

enum StoryStatus {
  DRAFT
  IN_REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum ArticleType {
  breaking_news
  developing_story
  explainer
  analysis
  background
  deep_dive
  data_story
  visual_story
  timeline
  technology
  science
  business
  markets
  sports
  politics
  culture
  local
  weekly_digest
  topic_briefing
  liveblog
  fact_check
  opinion
  investigation
}

enum ClientType {
  gemini
  gemini_spark
  chatgpt
  claude
  custom_mcp
  human_web
  human_mobile
  internal_service
}

enum CreatedVia {
  mcp
  web
  mobile
  api
  admin
}

enum EntityType {
  PERSON
  ORGANIZATION
  COUNTRY
  LOCATION
  TECHNOLOGY
  PRODUCT
  INSTITUTION
}

enum SourceType {
  NEWS_ARTICLE
  OFFICIAL_DOCUMENT
  PRESS_RELEASE
  ACADEMIC_PAPER
  DATASET
  INTERVIEW
  TRANSCRIPT
  OTHER
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  stories             Story[]
  events              Event[]
  topics              Topic[]
  entities            Entity[]
  sources             Source[]
  publishers          Publisher[]
  idempotencyRecords  IdempotencyRecord[]
  auditLogs           AuditLog[]
  comments            Comment[]
  storyReactions      StoryReaction[]
  bookmarks           Bookmark[]
  editorialNotifications EditorialNotification[]
  storyClusters       StoryCluster[]
  webhookSubscriptions WebhookSubscription[]

  @@map("organizations")
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  email          String       @unique
  name           String
  role           String       @default("editor") // admin, editor, author, viewer, ai_agent
  scopes         String[]     @default(["news:read"])
  passwordHash   String?
  clientType     String       @default("human_web")
  status         String       @default("active")
  bio            String?
  avatarUrl      String?
  preferences    Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  storiesAuthored Story[]
  auditLogs      AuditLog[]

  @@map("users")
}

model Event {
  id             String       @id @default(uuid())
  organizationId String
  title          String
  summary        String
  status         String       @default("ACTIVE")
  occurredAt     DateTime     @default(now())
  location       String?
  coordinates    Float[]
  topicIds       String[]     @default([])
  entityIds      String[]     @default([])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stories        Story[]

  @@index([organizationId, status])
  @@map("events")
}

model Story {
  id                   String        @id @default(uuid())
  organizationId       String
  slug                 String
  title                String
  summary              String
  status               StoryStatus   @default(DRAFT)
  articleType          ArticleType   @default(developing_story)
  eventId              String?
  currentVersionNumber Int           @default(1)
  currentVersionId     String?
  topicIds             String[]      @default([])
  entityIds            String[]      @default([])
  sourceIds            String[]      @default([])
  heroImageUrl         String?
  createdVia           CreatedVia    @default(mcp)
  createdByClient      ClientType    @default(gemini)
  authorId             String
  idempotencyKey       String?
  publishedAt          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  organization         Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author               User          @relation(fields: [authorId], references: [id])
  event                Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  versions             StoryVersion[]
  blocks               StoryBlock[]
  comments             Comment[]
  reactions            StoryReaction[]
  bookmarks            Bookmark[]
  liveblogEntries      LiveblogEntry[]
  provenance           StoryProvenance?

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@index([organizationId, idempotencyKey])
  @@index([organizationId, publishedAt])
  @@map("stories")
}

model StoryVersion {
  id            String     @id @default(uuid())
  storyId       String
  versionNumber Int
  title         String
  summary       String
  blocksJson    Json       // Full structured snapshot of blocks
  changeSummary String?
  clientType    ClientType @default(gemini)
  authorId      String
  createdAt     DateTime   @default(now())

  story         Story      @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, versionNumber])
  @@map("story_versions")
}

model StoryBlock {
  id          String   @id @default(uuid())
  storyId     String
  blockType   String
  sortOrder   Int
  data        Json
  metadata    Json?
  citationIds String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  story       Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([storyId, sortOrder])
  @@map("story_blocks")
}

model Topic {
  id             String       @id @default(uuid())
  organizationId String
  slug           String
  name           String
  description    String?
  aliases        String[]     @default([])
  parentTopicId  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, slug])
  @@map("topics")
}

model Entity {
  id             String       @id @default(uuid())
  organizationId String
  slug           String
  name           String
  type           EntityType
  description    String?
  aliases        String[]     @default([])
  avatarUrl      String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, slug])
  @@index([organizationId, type])
  @@map("entities")
}

model Publisher {
  id               String   @id @default(uuid())
  organizationId   String
  name             String
  slug             String
  domain           String
  logoUrl          String?
  description      String?
  category         String   @default("general")
  country          String?
  language         String   @default("en")
  websiteUrl       String?
  biasRating       String?
  credibilityScore Float?
  isVerified       Boolean  @default(true)
  followerCount    Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sources          Source[]

  @@unique([organizationId, slug])
  @@unique([organizationId, domain])
  @@index([organizationId, category])
  @@map("publishers")
}

model Source {
  id                 String       @id @default(uuid())
  organizationId     String
  publisherId        String?
  domain             String?
  url                String
  canonicalUrl       String?
  title              String
  publisher          String
  author             String?
  publishedAt        DateTime?
  retrievedAt        DateTime     @default(now())
  language           String       @default("en")
  sourceType         SourceType   @default(NEWS_ARTICLE)
  licenseMetadata    String?
  permissibleExcerpt String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  publisherRef       Publisher?   @relation(fields: [publisherId], references: [id], onDelete: SetNull)
  citations          Citation[]

  @@unique([organizationId, url])
  @@index([organizationId, publisher])
  @@index([organizationId, publisherId])
  @@map("sources")
}

model Citation {
  id              String       @id @default(uuid())
  organizationId  String
  storyId         String
  blockId         String?
  sourceId        String
  claimText       String
  confidenceScore Float?
  createdAt       DateTime     @default(now())

  source          Source       @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([storyId])
  @@index([sourceId])
  @@map("citations")
}

model IdempotencyRecord {
  id             String       @id @default(uuid())
  organizationId String
  key            String
  action         String
  responseJson   Json
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@map("idempotency_records")
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  clientType     ClientType
  action         String
  resourceType   String
  resourceId     String?
  payloadSummary Json?
  ipAddress      String?
  requestId      String?
  durationMs     Int?
  status         String
  errorMessage   String?
  timestamp      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, timestamp])
  @@index([organizationId, action])
  @@map("audit_logs")
}

model Comment {
  id               String       @id @default(uuid())
  storyId          String
  organizationId   String
  authorId         String
  authorName       String
  authorRole       String       @default("reader")
  content          String
  parentId         String?
  status           String       @default("approved")
  likesCount       Int          @default(0)
  moderationReason String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  story            Story        @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([storyId, status])
  @@index([organizationId])
  @@map("comments")
}

model StoryReaction {
  id             String       @id @default(uuid())
  storyId        String
  userId         String
  organizationId String
  reactionType   String
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  story          Story        @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([storyId, userId, reactionType])
  @@index([organizationId])
  @@map("story_reactions")
}

model Bookmark {
  id             String       @id @default(uuid())
  storyId        String
  userId         String
  organizationId String
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  story          Story        @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([userId, storyId])
  @@index([organizationId])
  @@map("bookmarks")
}

model EditorialNotification {
  id             String       @id @default(uuid())
  organizationId String
  authorId       String
  type           String
  severity       String       @default("info")
  title          String
  message        String
  storyId        String?
  targetRole     String?
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([authorId, isRead])
  @@index([organizationId])
  @@map("editorial_notifications")
}

model StoryCluster {
  id             String       @id @default(uuid())
  organizationId String
  title          String
  summary        String?
  leadStoryId    String
  storyIds       String[]     @default([])
  topic          String?
  category       String?
  perspectives   Json         @default("[]")
  timeline       Json         @default("[]")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([leadStoryId])
  @@map("story_clusters")
}

model LiveblogEntry {
  id           String   @id @default(uuid())
  storyId      String
  headline     String
  content      String
  isKeyEvent   Boolean  @default(false)
  authorId     String
  authorName   String?
  authorAvatar String?
  timestamp    DateTime @default(now())

  story        Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([storyId, timestamp])
  @@map("liveblog_entries")
}

model NewsletterSubscription {
  id         String   @id @default(uuid())
  email      String   @unique
  frequency  String   @default("daily")
  categories String[] @default([])
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([email, active])
  @@map("newsletter_subscriptions")
}

model NewsletterDigest {
  id             String   @id @default(uuid())
  frequency      String   @default("daily")
  category       String?
  recipientCount Int      @default(0)
  storyIds       String[] @default([])
  contentSummary String?
  metadata       Json?
  generatedAt    DateTime @default(now())

  @@index([frequency, generatedAt])
  @@map("newsletter_digests")
}

model StoryCollection {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  curatorId   String
  curatorName String?
  isPublic    Boolean  @default(true)
  storyIds    String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([curatorId])
  @@index([isPublic])
  @@map("story_collections")
}

model WebhookSubscription {
  id             String       @id @default(uuid())
  organizationId String
  url            String
  events         String[]     @default([])
  secret         String
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, active])
  @@map("webhook_subscriptions")
}

model WebhookDispatchLog {
  id             String   @id @default(uuid())
  subscriptionId String
  event          String
  targetUrl      String
  statusCode     Int
  success        Boolean
  durationMs     Int
  attempt        Int      @default(1)
  errorMessage   String?
  dispatchedAt   DateTime @default(now())

  @@index([subscriptionId, dispatchedAt])
  @@map("webhook_dispatch_logs")
}

model StoryProvenance {
  id                  String   @id @default(uuid())
  storyId             String   @unique
  generatorModel      String
  promptHash          String
  confidenceScore     Float
  humanReviewedBy     String?
  watermarkSignature  String
  c2paManifestUrl     String?
  generationTimestamp DateTime @default(now())
  createdAt           DateTime @default(now())

  story               Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@map("story_provenance")
}

model ReadingProgress {
  id         String   @id @default(uuid())
  userId     String
  storyId    String
  percentage Int
  completed  Boolean  @default(false)
  updatedAt  DateTime @updatedAt

  @@unique([userId, storyId])
  @@index([userId, updatedAt])
  @@map("reading_progress")
}

model FollowRelationship {
  id         String   @id @default(uuid())
  userId     String
  targetType String
  targetId   String
  createdAt  DateTime @default(now())

  @@unique([userId, targetType, targetId])
  @@index([userId])
  @@map("follow_relationships")
}

model FactCheck {
  id        String   @id @default(uuid())
  claim     String
  claimant  String
  rating    String
  summary   String
  checker   String
  sources   String[] @default([])
  checkedAt DateTime @default(now())

  @@index([rating])
  @@map("fact_checks")
}

model StoryShare {
  id        String   @id @default(uuid())
  storyId   String
  platform  String?
  userId    String?
  createdAt DateTime @default(now())

  @@index([storyId])
  @@map("story_shares")
}

