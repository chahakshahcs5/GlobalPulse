# AI-Operable News Publishing Platform Environment Variables

# Server Configuration
PORT=4000
API_BASE_URL=http://localhost:4000
MCP_PORT=4001
MCP_BASE_URL=http://localhost:4001

# Database Configuration (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_news?schema=public

# Redis Configuration (BullMQ + Caching)
REDIS_URL=redis://localhost:6379

# Object Storage: Backblaze B2 (S3-Compatible Native API)
# To obtain B2 credentials: create an Application Key with read/write permissions to your bucket
S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
S3_REGION=us-east-005
S3_BUCKET=news-media
S3_ACCESS_KEY=your_b2_key_id
S3_SECRET_KEY=your_b2_application_key
S3_PUBLIC_URL=https://news-media.s3.us-east-005.backblazeb2.com

# OAuth 2.1 & Security
OAUTH_ISSUER=http://localhost:4000/auth
OAUTH_AUDIENCE=https://news.platform/mcp
JWT_SECRET=super-secret-development-jwt-signing-key-change-in-production

# Dev/Test Token Configuration (format: role:clientType)
# Use as: Authorization: Bearer dev-admin
DEV_TOKEN_ADMIN=admin:internal_service
DEV_TOKEN_EDITOR=editor:human_web
DEV_TOKEN_JOURNALIST=journalist:human_web
DEV_TOKEN_READER=reader:human_mobile
DEV_TOKEN_GEMINI=ai_agent:gemini_spark
DEV_TOKEN_CHATGPT=ai_agent:chatgpt
DEV_TOKEN_CLAUDE=ai_agent:claude

# Observability
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Next.js Web Frontend & CMS (must match API PORT for local dev)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_MCP_URL=http://localhost:4001/mcp

