# GlobalPulse environment.
#
# Copy to `.env` and edit values. dotenv reads these literally: do not use
# shell syntax such as FOO=$BAR, `cmd`, or line continuations. Every value
# below is a plain string.
#
# Platform-specific starting points:
#   copy .env.windows.example .env
#   copy .env.termux.example .env
#
# See docs/platforms.md for the commands that consume these variables.

# ---------------------------------------------------------------------------
# Process / HTTP servers
# ---------------------------------------------------------------------------
NODE_ENV=development

# API (Fastify + NestJS)
PORT=4000
HOST=0.0.0.0
API_BASE_URL=http://localhost:4000

# MCP server (Streamable HTTP / JSON-RPC)
MCP_PORT=4001
MCP_HOST=0.0.0.0
MCP_BASE_URL=http://localhost:4001/mcp

# Web portal (Next.js). `pnpm dev:web` reads WEB_PORT (default 3002);
# `next start` and scripts/start-web.mjs also honour PORT.
WEB_PORT=3002
# Optional: host interface for `next dev` (default 127.0.0.1) and an explicit
# path to a standalone server.js if you move the build.
# WEB_HOST=127.0.0.1
# NEXT_STANDALONE_SERVER=apps/web/.next/standalone/apps/web/server.js
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_MCP_URL=http://localhost:4001/mcp

# Block Studio (optional app)
STUDIO_PORT=3003
NEXT_PUBLIC_STUDIO_URL=http://localhost:3003
NEXT_PUBLIC_WEB_URL=http://localhost:3002
NEXT_PUBLIC_CMS_URL=http://localhost:3002

# Where public feeds, syndication and newsletter links point.
BASE_URL=http://localhost:4000
PUBLIC_SITE_URL=http://localhost:3002

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Windows / Docker example:
#   postgresql://postgres:postgres@localhost:5432/ai_news?schema=public
# Termux example (no Unix socket; plain TCP to the loopback addon):
#   postgresql://globalpulse:globalpulse@127.0.0.1:5432/globalpulse?schema=public
# Managed PostgreSQL with TLS:
#   postgresql://user:pass@host:5432/db?schema=public&sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_news?schema=public
# "prisma" requires a real connection; "memory" is the explicit test fallback.
DATABASE_ENGINE=prisma
# Escape hatch for a deliberately ephemeral production deployment.
ALLOW_IN_MEMORY_PRODUCTION=false

# ---------------------------------------------------------------------------
# Redis (BullMQ + cache + SSE fan-out)
# ---------------------------------------------------------------------------
# Windows: redis://localhost:6379
# Termux:  redis://127.0.0.1:6379
REDIS_URL=redis://localhost:6379
INGESTION_POLL_INTERVAL_MINUTES=15
ALERT_EVALUATION_INTERVAL_MINUTES=5
SCHEDULER_INTERVAL_MS=15000

# ---------------------------------------------------------------------------
# Object storage: Backblaze B2 (S3-compatible)
# ---------------------------------------------------------------------------
S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
S3_REGION=us-east-005
S3_BUCKET=news-media
S3_ACCESS_KEY=your_b2_key_id
S3_SECRET_KEY=your_b2_application_key
S3_PUBLIC_URL=https://news-media.s3.us-east-005.backblazeb2.com
# "true" for MinIO/B2 path-style buckets, "false" for virtual-hosted style.
S3_FORCE_PATH_STYLE=false
# Optional aliases kept for older deployments.
# B2_ENDPOINT=
# B2_REGION=
# B2_BUCKET=
# B2_APPLICATION_KEY_ID=
# B2_APPLICATION_KEY=
# MINIO_ENDPOINT=
# MINIO_ROOT_USER=
# MINIO_ROOT_PASSWORD=

# ---------------------------------------------------------------------------
# Auth / OAuth 2.1
# ---------------------------------------------------------------------------
OAUTH_ISSUER=http://localhost:4000/auth
OAUTH_AUDIENCE=https://news.platform/mcp
JWT_SECRET=super-secret-development-jwt-signing-key-change-in-production
JWT_ISSUER=http://localhost:4000/auth
JWT_AUDIENCE=https://news.platform/mcp
# Minimum 32 characters in production. Override in production:
# OAUTH_ADMIN_CLIENT_SECRET=
# OAUTH_GEMINI_CLIENT_SECRET=
# OAUTH_CHATGPT_CLIENT_SECRET=
# Set to "true" to accept DEV_TOKEN_* values even in production.
ALLOW_DEV_TOKENS=false
# Shared parent cookie domain for portal + studio on sibling hosts:
# COOKIE_DOMAIN=.example.com

# Dev/Test tokens (format: role:clientType), used as `Authorization: Bearer dev-admin`.
DEV_TOKEN_ADMIN=admin:internal_service
DEV_TOKEN_EDITOR=editor:human_web
DEV_TOKEN_JOURNALIST=journalist:human_web
DEV_TOKEN_READER=reader:human_mobile
DEV_TOKEN_GEMINI=ai_agent:gemini_spark
DEV_TOKEN_CHATGPT=ai_agent:chatgpt
DEV_TOKEN_CLAUDE=ai_agent:claude

# ---------------------------------------------------------------------------
# HTTP hardening / observability
# ---------------------------------------------------------------------------
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
TRUST_PROXY=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
RATE_LIMIT_ALLOW_LIST=
MCP_RATE_LIMIT_MAX=200
MCP_RATE_LIMIT_WINDOW_MS=60000
# Comma-separated exact origins. Empty uses the built-in development list.
ALLOWED_ORIGINS=
PROVENANCE_HMAC_SECRET=globalpulse-ai-provenance-watermark-key-2026

# Optional explicit dotenv file (absolute or relative to the process cwd).
# ENV_FILE=.env

# Optional: set HUSKY=0 to skip the git hook installer on machines without git.
# HUSKY=0
