# AI-Operable News Publishing Platform Environment Variables

# Server Configuration
PORT=4000
API_BASE_URL=http://localhost:4000
MCP_PORT=4001
MCP_BASE_URL=http://localhost:4001

# Database Configuration (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_news?schema=public

# Redis Configuration (BullMQ + Caching)
REDIS_URL=redis://localhost:6379

# Object Storage (S3 / MinIO)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=news-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# OAuth 2.1 & Security
OAUTH_ISSUER=http://localhost:4000/auth
OAUTH_AUDIENCE=https://news.platform/mcp
JWT_SECRET=super-secret-development-jwt-signing-key-change-in-production

# Observability
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Next.js Web Frontend & CMS
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_MCP_URL=http://localhost:3001/mcp

