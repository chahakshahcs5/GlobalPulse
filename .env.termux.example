# GlobalPulse - Termux on non-root Android (bionic, arm64, $PREFIX).
# Copy to `.env` in the repository root:
#   cp .env.termux.example .env
# Then follow docs/platforms.md. Do not copy node_modules from a desktop.
#
# All values are literal. There is no shell expansion inside this file.
# phleet injects DATABASE_URL and REDIS_URL for managed addons; these values
# are for a phone-local PostgreSQL/Redis started by the user.

NODE_ENV=development

# Use the port phleet assigns for a managed service. For a manual run, 4000.
PORT=4000
HOST=127.0.0.1
API_BASE_URL=http://127.0.0.1:4000

# phleet convention: the MCP service receives the same PORT, and MCP_PORT is
# set from it. For a manual two-process run use 4001.
MCP_PORT=4001
MCP_HOST=127.0.0.1
MCP_BASE_URL=http://127.0.0.1:4001/mcp

WEB_PORT=3002
API_INTERNAL_URL=http://127.0.0.1:4000
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_MCP_URL=http://127.0.0.1:4001/mcp

# Termux PostgreSQL listens on loopback TCP. No /var/run Unix socket exists,
# and no superuser is required.
DATABASE_URL=postgresql://globalpulse:globalpulse@127.0.0.1:5432/globalpulse?schema=public
DATABASE_ENGINE=prisma

# Termux Redis listens on loopback TCP.
REDIS_URL=redis://127.0.0.1:6379

JWT_SECRET=super-secret-development-jwt-signing-key-change-in-production
OAUTH_ISSUER=http://127.0.0.1:4000/auth
OAUTH_AUDIENCE=https://news.platform/mcp

DEV_TOKEN_ADMIN=admin:internal_service
DEV_TOKEN_EDITOR=editor:human_web
DEV_TOKEN_JOURNALIST=journalist:human_web
DEV_TOKEN_READER=reader:human_mobile
DEV_TOKEN_GEMINI=ai_agent:gemini_spark
DEV_TOKEN_CHATGPT=ai_agent:chatgpt
DEV_TOKEN_CLAUDE=ai_agent:claude

LOG_LEVEL=info

S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
S3_REGION=us-east-005
S3_BUCKET=news-media
S3_ACCESS_KEY=your_b2_key_id
S3_SECRET_KEY=your_b2_application_key
S3_PUBLIC_URL=https://news-media.s3.us-east-005.backblazeb2.com
S3_FORCE_PATH_STYLE=false
