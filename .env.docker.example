# Docker Compose Environment Variables
# Copy this file to .env (same directory as docker-compose.yml) and fill in the values.
# These are required when running `docker compose up`.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_to_a_secure_password
POSTGRES_DB=ai_news

# MinIO Object Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_to_a_secure_password

# JWT Secret (minimum 32 characters, cryptographically random)
JWT_SECRET=change_me_to_a_cryptographically_random_string_at_least_32_chars
