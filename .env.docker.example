# Docker Compose Environment Variables
# Copy this file to .env (same directory as docker-compose.yml) and fill in the values.
# These are required when running `docker compose up`.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_to_a_secure_password
POSTGRES_DB=ai_news

# Backblaze B2 Object Storage (S3-Compatible)
S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
S3_REGION=us-east-005
S3_BUCKET=your-b2-bucket-name
S3_ACCESS_KEY=your_b2_keyID
S3_SECRET_KEY=your_b2_applicationKey
S3_PUBLIC_URL=https://your-b2-bucket-name.s3.us-east-005.backblazeb2.com

# JWT Secret (minimum 32 characters, cryptographically random)
JWT_SECRET=change_me_to_a_cryptographically_random_string_at_least_32_chars

# OAuth 2.1 client secrets (required in production; generate random values)
OAUTH_ADMIN_CLIENT_SECRET=change_me_admin_client_secret
OAUTH_GEMINI_CLIENT_SECRET=change_me_gemini_client_secret
OAUTH_CHATGPT_CLIENT_SECRET=change_me_chatgpt_client_secret

# Optional: transactional email webhook for newsletters/alerts
# EMAIL_WEBHOOK_URL=https://mailer.example.com/send
# EMAIL_WEBHOOK_TOKEN=

# Optional: protect /metrics
# METRICS_TOKEN=
# Payment-provider webhook secret (entitlement is granted only by a signed event).
# BILLING_WEBHOOK_SECRET=
# Optional TTS provider; otherwise the worker synthesizes a playable WAV.
# TTS_WEBHOOK_URL=
# TTS_WEBHOOK_TOKEN=
# Browser-visible checkout URL for /subscribe.
# NEXT_PUBLIC_SUBSCRIPTION_URL=

# Optional: require object storage for readiness
# REQUIRE_STORAGE=false


